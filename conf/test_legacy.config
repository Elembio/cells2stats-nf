/*
========================================================================================
    Nextflow test profile — LEGACY (pre-1.4.0-beta) param names
========================================================================================
    Identical to `conf/test.config` but expresses the inputs using the deprecated
    unprefixed param names, so it exercises the backwards-compatibility alias in
    nextflow.config. Running `-profile test_legacy` must resolve to the same effective
    c2s_* params as `-profile test`.

        nextflow run Elembio/cells2stats-nf -profile test_legacy,docker

----------------------------------------------------------------------------------------
*/

params {

    config_profile_name        = 'Test profile (legacy param names)'
    config_profile_description = 'Same as test, but supplies deprecated pre-1.4.0-beta param names via the backwards-compat alias'

    // Limit resources so that this can run on CI
    max_cpus   = 2
    max_memory = 6.GB
    max_time   = 6.h

    // Input data — public Element cytoprofiling dataset (single tile for fast execution)
    id      = "20250820_AV222902_WHTF-1078"
    run_dir = "s3://element-public-data/cytoprofiling/20250820_AV222902_WHTF-1078_20251112T053054Z/"

    tile = ["L1R01C01S1"]  // 1 Tile (name unchanged across versions)

    // legacy name — remapped to c2s_skip_html_report by the alias
    skip_html_report = false

    // legacy container names — remapped to c2s_container_url / c2s_container_tag.
    // Set to the same values as the nextflow.config defaults so the effective run
    // matches `-profile test`, while still exercising the (load-bearing) container alias.
    container_url = "904220683607.dkr.ecr.us-west-2.amazonaws.com/cells2stats-release"
    container_tag = "1.4.0-beta"

}

// ═══════════════════════════════════════════════════════════════════════════════
// PROCESS RESOURCES (reduced for testing)
// ═══════════════════════════════════════════════════════════════════════════════

process {
    // cells2stats
    withName: CELLS2STATS {
        cpus = 8
        memory = 15.GB
        time = 2.h
        maxRetries = 2
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
// INFRASTRUCTURE
// ═══════════════════════════════════════════════════════════════════════════════

cleanup = false
